/* ---------- 批量导入（B 端提效：多份简历 → AI 匹配分 → 自动生成链接） ---------- */
var BATCH_ITEMS = [];
$('#modeSingle').onclick = function () { $('#modeSingle').classList.add('on'); $('#modeBatch').classList.remove('on'); $('#singleImport').classList.remove('hide'); $('#batchImport').classList.add('hide'); };
$('#modeBatch').onclick = function () { $('#modeBatch').classList.add('on'); $('#modeSingle').classList.remove('on'); $('#batchImport').classList.remove('hide'); $('#singleImport').classList.add('hide'); };
$('#batchFiles').addEventListener('change', function () {
  var files = Array.prototype.slice.call(this.files).slice(0, 20);
  if (!files.length) return;
  BATCH_ITEMS = []; $('#batchResult').innerHTML = '';
  var done = 0;
  $('#batchStatus').textContent = '正在提取 0 / ' + files.length + ' 份…';
  files.forEach(function (f) {
    var name = (f.name || '候选人').replace(/\.(txt|md|docx|pdf|csv)$/i, '').slice(0, 30);
    extractText(f).then(function (text) { BATCH_ITEMS.push({ cand: name, text: text }); })
      .catch(function () { BATCH_ITEMS.push({ cand: name, text: '' }); })
      .then(function () {
        done++;
        $('#batchStatus').textContent = '正在提取 ' + done + ' / ' + files.length + ' 份…';
        if (done === files.length) {
          var ok = BATCH_ITEMS.filter(function (x) { return x.text.length >= 20; }).length;
          $('#batchStatus').textContent = '已提取 ' + ok + ' / ' + files.length + ' 份有效（正文不足 20 字的将被跳过）';
        }
      });
  });
});
$('#batchRun').onclick = function () {
  var items = BATCH_ITEMS.filter(function (x) { return x.text.length >= 20; });
  if (!items.length) { toast('请先选择并成功提取简历文件'); return; }
  var btn = this; btn.disabled = true; btn.textContent = 'AI 分析中…';
  api('/api/resumes/batch', { method: 'POST', body: { jobId: CURRENT_JOB.id, items: items } })
    .then(function (out) {
      btn.disabled = false; btn.textContent = 'AI 匹配分析并生成链接';
      paintBatchResult(out);
      toast('批量分析完成');
    })
    .catch(function (d) { btn.disabled = false; btn.textContent = 'AI 匹配分析并生成链接'; toast(d && d.error ? d.error : '批量分析成功，请刷新页面'); });
};
function paintBatchResult(out) {
  var rows = out.results.map(function (r) {
    if (!r.ok) return '<tr><th>' + esc(r.cand) + '</th><td><span class="tag red">失败</span> ' + esc(r.error || '') + '</td></tr>';
    var cls = r.match >= 75 ? '' : r.match >= 55 ? 'amber' : 'red';
    var full = location.origin + r.link;
    return '<tr><th style="white-space:nowrap">' + esc(r.cand) + '</th>' +
      '<td><div class="row" style="gap:8px"><span class="tag ' + cls + '" style="min-width:52px;text-align:center">匹配 ' + r.match + '</span>' +
      '<div class="matchbar grow"><i style="width:' + r.match + '%"></i></div></div>' +
      '<div class="muted" style="margin-top:4px">' + (r.skills && r.skills.length ? '技能：' + esc(r.skills.join('、')) : '未检出岗位技能词') + '</div></td>' +
      '<td style="white-space:nowrap"><button class="plain" onclick="copyText(this.dataset.l,\'已复制\')" data-l="' + esc(full) + '">复制链接</button></td></tr>';
  }).join('');
  var allLinks = out.results.filter(function (r) { return r.ok; })
    .map(function (r) { return r.cand + '：' + location.origin + r.link; }).join('\n');
  $('#batchResult').innerHTML =
    '<div class="h2">批量分析结果 · ' + esc(out.jobName) + '</div>' +
    '<div class="muted">按匹配分排序发给优先级最高的候选人；链接逐人独立，复制即可发送。</div>' +
    '<table class="tb" style="margin-top:10px"><tbody>' + rows + '</tbody></table>' +
    '<button class="ghost mtbtn" onclick="copyText(this.dataset.l,\'全部链接已复制\')" data-l="' + esc(allLinks) + '">复制全部候选人链接</button>';
}

