  $('#stepSubmit').classList.toggle('hide', !last || CAND.generating);
  $('#stepSubmit').textContent = CAND.isRound2 ? '提交面试' : '提交第一轮';
  $('#stepNext').classList.toggle('hide', last);
  if (CAND.generating) {
