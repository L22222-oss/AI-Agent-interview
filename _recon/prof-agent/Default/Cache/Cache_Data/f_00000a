    '<div class="row"><div class="grow"><label class="lb">入职日期</label><input id="ofStart" value="' + addDays(14) + '"></div>' +
    '<div class="grow"><label class="lb">确认有效期至</label><input id="ofExpire" value="' + addDays(7) + '"></div></div>' +
    '<label class="lb">备注（可选）</label><input id="ofNote">' +
    '<button style="margin-top:12px">保存并发出</button></form>';
