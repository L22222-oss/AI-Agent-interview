/** AI 逐题评估：对单题回答打分（0-100）+ 证据评语 + 模板化回答标记 */
async function aiEvalAnswer(idx) {
  var dim = CAND.dims[idx] || 'communication';
  var sys = '你是严格的中文面试评估官。只输出一个 JSON 对象：{"score":0到100的整数,"comment":"不超过60字的评语，必须引用回答原文中的短语作为证据","flagged":布尔}。评分标准：回答结构完整（如 STAR：情境-任务-行动-结果）、有具体细节和数字、紧扣题目为高分；空泛套话、模板化、明显背诵、答非所问给低分且 flagged=true。除 JSON 外不要输出任何内容。';
  var user = '【考察维度】' + DIM_NAME[dim] + '\n【问题】' + CAND.questions[idx]
    + (CAND.materials[idx] ? '\n【材料】' + CAND.materials[idx] : '')
    + '\n【候选人回答】\n' + String(CAND.answers[idx] || '').slice(0, 1500);
  try {
    var judged = await withTimeout(api('/api/agent/eval-round2', { method: 'POST', body: {
      questions: [CAND.questions[idx]], answers: [CAND.answers[idx]], dims: [dim],
      materials: [CAND.materials[idx]], resume: CAND.resume
    }}), 30000);
    if (judged && judged[0]) return judged[0];
  } catch (e) {
    if (!CLOUD) throw e;
  }
  var d = await withTimeout(llmJSON(sys, user), 25000);
  var score = Math.round(Number(d && d.score));
  if (!isFinite(score)) throw new Error('bad-eval');
  return { score: Math.max(0, Math.min(100, score)), comment: String((d && d.comment) || '').slice(0, 200), flagged: !!(d && d.flagged) };
}
function paintStep() {
  var total = CAND.total;
