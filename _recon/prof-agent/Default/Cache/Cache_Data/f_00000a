<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#6d28d9">
<meta name="format-detection" content="telephone=no,email=no,address=no">
<meta name="x5-orientation" content="portrait">
<meta name="screen-orientation" content="portrait">
<title>面试智能体</title>
<style>
:root{
  --ink:#26203a; --ink2:#6f6890; --line:#e8e4f4; --bg:#faf9fd; --card:#ffffff;
  --brand:#6d28d9; --brand2:#8b5cf6; --brand-soft:#f1eafd; --warn:#b45309; --bad:#be123c; --ok:#15803d;
  --sh:0 1px 3px rgba(60,40,110,.10); --sh2:0 6px 20px rgba(60,40,110,.13); --r:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.6}
button{font:inherit;cursor:pointer;border:none;border-radius:10px;padding:9px 16px;background:var(--brand);color:#fff;transition:.15s}
button:hover{background:var(--brand2)} button:disabled{opacity:.45;cursor:not-allowed}
button.ghost{background:#fff;color:var(--brand);border:1px solid var(--brand)}
button.plain{background:#f1eff8;color:var(--ink)} button.danger{background:#fdf0ee;color:var(--bad)}
input,textarea,select{font:inherit;border:1px solid var(--line);border-radius:10px;padding:9px 12px;background:#fff;width:100%;color:var(--ink)}
textarea{resize:vertical;min-height:110px}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--brand2)}
.card{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:18px}
.muted{color:var(--ink2);font-size:12.5px} .h1{font-size:20px;font-weight:700} .h2{font-size:16px;font-weight:700;margin-bottom:6px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap} .grow{flex:1}
.hide{display:none!important}
.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:9px 18px;border-radius:10px;box-shadow:var(--sh2);opacity:0;pointer-events:none;transition:.25s;z-index:99}
.toast.on{opacity:1}
.tag{display:inline-block;padding:2px 10px;border-radius:999px;font-size:12px;background:var(--brand-soft);color:var(--brand)}
.tag.gray{background:#efedf6;color:var(--ink2)} .tag.amber{background:#fbf1dd;color:var(--warn)} .tag.red{background:#fbe9e7;color:var(--bad)} .tag.blue{background:#efe9fc;color:#2b6cb0}
/* 顶栏 */
#topbar{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);z-index:10;padding:0 20px;display:flex;align-items:center;gap:16px;height:54px;flex-shrink:0}
/* ===== 固定视口应用壳：页面整体不滚动，功能入口一屏组织，内容超出时各页内部滚动 ===== */
html,body{height:100%}
body{overflow:hidden}
#loginPage{height:100%;overflow-y:auto}
#adminApp,#candApp,#offerApp,#portalApp{height:100%;display:flex;flex-direction:column;overflow:hidden}
#main{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;max-width:980px;width:100%;margin:0 auto;padding:14px 16px 24px}
.logo{font-weight:800;font-size:16px;color:var(--brand)}
.tabs{display:flex;gap:4px;margin-left:8px}
.tabs button svg{display:none}
.tabs button{background:transparent;color:var(--ink2);padding:6px 14px;border-radius:8px}
.tabs button.on{background:var(--brand-soft);color:var(--brand);font-weight:600}
/* 居中弹窗（创建面试等） */
.modal{position:fixed;inset:0;z-index:9998;background:rgba(24,18,46,.45);display:flex;align-items:center;justify-content:center;padding:18px}
.modal .card{max-width:540px;width:100%;max-height:88vh;overflow-y:auto;margin:0}
/* 岗位详情：子页签导航 + 固定操作行，功能入口一屏分组 */
.jdstat{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
.jdstat .score{padding:8px 6px;margin:0}
.jdstat .score b{font-size:19px}
.jdnav{display:flex;gap:6px;overflow-x:auto;margin-top:12px;padding-bottom:2px}
.jdnav .seg{flex-shrink:0;padding:5px 13px}
.jdfoot{display:flex;gap:10px;margin-top:14px}
.jdfoot button{flex:1}
/* C 端答题页：一屏布局，作答区自适应撑满 */
#candStep .card{display:flex;flex-direction:column;min-height:calc(100dvh - 150px)}
#stepAnswer{flex:1;min-height:110px;resize:none}
/* C 端落地页：一屏布局——头部与底部操作行固定，表单区不足时内部滚动 */
#candIntro{display:flex;flex-direction:column;height:100%;min-height:0}
#candIntro .cand-head.cand-slim{flex-shrink:0;padding:14px 16px;margin-bottom:10px}
#candIntro .cand-head.cand-slim h1{font-size:19px;margin-bottom:3px}
.rules-head{display:flex;align-items:center;gap:8px;width:100%;background:var(--brand-soft);border:none;border-radius:10px;padding:9px 12px;font-size:13px;color:var(--brand);font-weight:600;cursor:pointer}
#rulesBody{margin-top:8px;font-size:13px}
.candform{flex:1;min-height:0;overflow-y:auto;margin-bottom:10px}
.candfoot{flex-shrink:0;padding-bottom:calc(6px + env(safe-area-inset-bottom))}
/* 简历输入分段切换：未选中项深色文字（覆盖全局按钮白字默认） */
.segrow{display:flex;gap:8px}
.segrow .seg{flex:1;padding:8px 10px;color:var(--ink2);font-weight:600}
.segrow .seg.on{color:#fff}
/* 岗位卡片 */
.jobgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-top:14px}
.job{cursor:default} .job .fname{font-size:16px;font-weight:700}
.chip{display:inline-block;background:#f3f0fb;border-radius:8px;padding:3px 9px;font-size:12px;margin:3px 4px 0 0}
.roles{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin:10px 0}
.role{border:1.5px solid var(--line);border-radius:12px;padding:10px 12px;cursor:pointer;background:#fff}
.role.on{border-color:var(--brand);background:var(--brand-soft)}
.role b{display:block;font-size:14px} .role span{font-size:12px;color:var(--ink2)}
/* 漏斗条 */
.funnel{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.seg{padding:4px 12px;border-radius:999px;border:1px solid var(--line);background:#fff;font-size:12.5px;cursor:pointer}
.seg.on{background:var(--brand);color:#fff;border-color:var(--brand)}
/* 报告条目 */
.rep{display:flex;gap:12px;align-items:flex-start;padding:14px 0;border-bottom:1px solid var(--line)}
.rep .avatar{width:38px;height:38px;border-radius:50%;background:var(--brand-soft);color:var(--brand);display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0}
.verdict{padding:2px 10px;border-radius:999px;font-size:12px;font-weight:600;white-space:nowrap;flex-shrink:0}
.v-pass{background:var(--brand-soft);color:var(--ok)} .v-fail{background:#fbe9e7;color:var(--bad)} .v-wait{background:#fbf1dd;color:var(--warn)}
.qa{border-left:3px solid var(--brand-soft);padding:8px 12px;margin:10px 0;background:#fcfbff;border-radius:0 10px 10px 0}
.qa .q{font-weight:600;margin-bottom:4px} .qa .a{white-space:pre-wrap;color:var(--ink)}
.score-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;margin:12px 0}
.score{background:#f5f2fc;border-radius:12px;padding:10px;text-align:center}
.score b{font-size:22px;display:block} .score span{font-size:12px;color:var(--ink2)}
.ai-eval{background:var(--brand-soft);border-radius:12px;padding:12px 14px;margin:10px 0;display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
/* 报告详情：第二轮问答 + 雷达图（手机上纵向堆叠，避免文字被挤成窄列） */
.r2flex{display:flex;gap:16px;align-items:flex-start;margin-top:10px}
.radar-card{flex-shrink:0;background:#faf8ff;border:1px solid var(--line);border-radius:12px;padding:12px 10px 8px;text-align:center}
.linkbox{background:#f5f2fc;border:1px dashed var(--line);border-radius:10px;padding:8px 12px;word-break:break-all;font-size:12.5px;color:var(--ink2)}
label.lb{display:block;font-weight:600;margin:12px 0 6px}
.step-hint{font-size:13px;color:var(--ink2);margin:8px 0}
.center{max-width:560px;margin:6vh auto}
.cand-head{background:var(--brand);color:#fff;border-radius:var(--r);padding:22px 20px;margin-bottom:16px}
.cand-head h1{font-size:22px;margin-bottom:6px}
.big{font-size:15px}
.progress{height:6px;background:#ece6f8;border-radius:99px;overflow:hidden;margin:10px 0}
.progress i{display:block;height:100%;background:var(--brand);transition:.2s}
.dim{display:inline-block;background:var(--brand-soft);color:var(--brand);border-radius:8px;padding:2px 10px;font-size:12px;margin-bottom:8px}
table.tb{width:100%;border-collapse:collapse;font-size:13px}
table.tb th,table.tb td{border-bottom:1px solid var(--line);padding:8px 6px;text-align:left}
/* 岗位工作台 */
.ws-head{padding:4px 2px 12px}
.ws-head .h1{margin:2px 0}
.sec-title{font-size:16px;font-weight:700}
.stat-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
.stat-card{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:16px}
.stat-card b{font-size:26px;display:block}
.stat-card span{font-size:12.5px;color:var(--ink2)}
.jobitem{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-top:10px;cursor:pointer;background:#fff}
.jobitem:active{background:#faf8ff}
/* 通用分页条：列表超出一页时显示 上一页/下一页 */
.pager{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:14px}
.pager button{padding:8px 20px}
.pager button[disabled]{opacity:.35;pointer-events:none}
.pager .pg{font-size:12.5px;color:var(--ink2);min-width:72px;text-align:center}
.jobitem .jname{font-size:15.5px;font-weight:700;display:flex;align-items:center;gap:7px}
.jobitem .jmeta{font-size:12.5px;color:var(--ink2);margin:4px 0 6px;padding-right:18px}
.jchev{float:right;color:var(--ink2);font-size:18px;line-height:1.4}
.dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;display:inline-block}
.dot.draft{background:#c4bfd8}.dot.published{background:var(--ok)}
.pt-row{display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13.5px}
.pt-row:last-child{border-bottom:none}
.pt-row .grow{min-width:0}
.pt-row .nm{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pt-row .sub{font-size:12px;color:var(--ink2)}
.pt-row button{padding:6px 12px;font-size:12.5px;flex-shrink:0}
.plan-step{display:flex;gap:10px;margin:10px 0}
.plan-step i{font-style:normal;flex-shrink:0;width:22px;height:22px;border-radius:50%;background:var(--brand-soft);color:var(--brand);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700}
.plan-step div{font-size:13.5px}
/* 材料 / 评估 / 签约 / 待办 */
.material{background:#f6f3ff;border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:6px 0 10px;font-size:13px;color:var(--ink)}
.material b{display:block;font-size:12px;color:var(--brand);margin-bottom:4px}
.evline{margin-top:6px;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.evline b{font-size:15px;color:var(--brand)}
.todorep{display:flex;gap:12px;align-items:flex-start;padding:12px 0;border-bottom:1px solid var(--line)}
#signPad{border:1.5px dashed var(--brand2);border-radius:12px;background:#fff;touch-action:none;width:100%;height:150px;display:block}
.mtbtn{width:100%;margin-top:10px}
/* 认证码 / 自助查询 */
.access-code{margin-top:14px;padding:14px;background:var(--brand-soft);border-radius:12px}
.access-code .cl{font-size:12.5px;color:var(--ink2);margin-bottom:6px}
.access-code .cv{font-size:30px;font-weight:800;letter-spacing:10px;color:var(--brand);font-family:Consolas,monospace}
.portal-box{max-width:440px;margin:6vh auto}
.code-input{letter-spacing:8px;font-size:20px;font-family:Consolas,monospace;text-align:center}
.p-step{border-left:3px solid var(--brand-soft);background:#fcfbff;border-radius:0 10px 10px 0;padding:10px 12px;margin:10px 0}
.p-step b{display:block;margin-bottom:2px}
.matchbar{height:6px;border-radius:99px;background:#ece6f8;overflow:hidden;min-width:80px}
.matchbar i{display:block;height:100%;background:var(--brand)}
/* 手机端：底部 Tab 导航（带图标 + 刘海屏安全区）+ 单列卡片流 */
@media (max-width:720px){
  #topbar{padding:0 12px;gap:8px}
  #whoAmI{display:none}
  .tabs{position:fixed;left:0;right:0;bottom:0;margin:0;background:#fff;border-top:1px solid var(--line);z-index:20;height:calc(60px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);justify-content:space-around;align-items:stretch}
  .tabs button{flex:1;height:100%;border-radius:0;font-size:11.5px;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--ink2);background:transparent}
  .tabs button svg{display:block;width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .tabs button.on{background:transparent;color:var(--brand);font-weight:600}
  #main{margin:0 auto;padding:10px 10px calc(88px + env(safe-area-inset-bottom))}
  .card{padding:14px;border-radius:12px}
  button{padding:11px 14px}
  .jobgrid{grid-template-columns:1fr}
  /* 工作台头部压缩：移动端首屏多显示一张岗位卡片 */
  .ws-head .h1{font-size:17px;margin:0}
  .ws-head .muted{font-size:11px}
  .ws-head .stat-cards{min-width:0}
  .ws-head .stat-card{padding:6px 10px}
  .ws-head .stat-card b{font-size:16px}
  /* 详情页 AI 准备子页：压缩纵向留白确保一屏 */
  .plan-step{margin:5px 0;font-size:13px}
  .plan-step i{width:20px;height:20px;font-size:11px}
  .jdstat .score{padding:5px 4px}
  .jdstat .score b{font-size:15px}
  .jdstat{margin-top:8px}
  .jdnav{margin-top:8px}
  #tab-detail .jdp .sec-title{margin-top:8px}
  #tab-detail .jdp .score-grid{margin-top:6px}
  #tab-detail .jdp .score{padding:6px}
  #tab-detail .jdp .score b{font-size:16px}
  #tab-detail .jdp button.ghost{padding:9px}
  .plan-step{margin:4px 0;font-size:12.5px}
  /* 岗位卡片：导入简历独占一行（主操作），报告/删除并排 */
  .job .row{gap:8px}
  .job .row .ghost{flex:1 1 100%;text-align:center}
  .job .row .plain,.job .row .danger{flex:1;text-align:center;padding:11px 6px}
  .rep{flex-wrap:wrap}
  .rep button{width:100%;margin-top:8px}
  .todorep{flex-wrap:wrap}
  .todorep button{width:100%;margin-top:8px}
  .score-grid{grid-template-columns:repeat(2,1fr)}
  /* 报告详情：三维能力总览（雷达图）置顶居中，问答纵向铺满 */
  .r2flex{flex-direction:column;gap:10px}
  .radar-card{width:100%}
  .radar-card svg{width:230px}
  #tab-detail .row{gap:8px}
  #tab-detail .row button{flex:1;text-align:center;min-width:0}
  #tab-detail .ai-eval button{width:100%;margin-top:6px}
  /* 详情页表单（Offer 表单）字段独占一行，不再左右挤 */
  #tab-detail form .row{gap:8px}
  #tab-detail form .row .grow{flex:1 1 100%}
  table.tb{display:block;overflow-x:auto}
  .cand-head{padding:20px 16px}
  .center{margin:3vh auto}
}
</style>
</head>
<body>

<div id="toast" class="toast"></div>

<!-- ================= 登录 / 注册 ================= -->
<div id="loginPage" class="center hide">
  <div class="card">
    <div class="h1" style="color:var(--brand)">面试智能体</div>
    <div class="muted" style="margin-bottom:14px">把面试交给 AI，你专注审核与决定。演示账号：admin / demo1234</div>
    <div id="loginForm">
      <label class="lb">登录账号</label><input id="lgAccount" placeholder="admin">
      <label class="lb">密码</label><input id="lgPwd" type="password" placeholder="密码">
      <div id="lgErr" class="muted" style="color:var(--bad);min-height:18px"></div>
      <button id="lgBtn" style="width:100%">登录</button>
      <div class="muted" style="margin-top:10px;text-align:center">还没有账号？<a href="#" id="toReg" style="color:var(--brand)">注册一个</a></div>
    </div>
    <div id="regForm" class="hide">
      <label class="lb">账号</label><input id="rgAccount" placeholder="字母/数字，3-40 位">
      <div class="muted" style="margin-top:4px">格式要求：3-40 位，仅限英文字母、数字或 . _ + -，不能用中文、空格或其他符号。</div>
      <label class="lb">显示名（选填）</label><input id="rgName" placeholder="你的名字，最多 30 个字">
      <label class="lb">密码</label><input id="rgPwd" type="password">
      <div class="muted" style="margin-top:4px">格式要求：至少 6 位，建议字母 + 数字组合。</div>
      <label class="lb">确认密码</label><input id="rgPwd2" type="password">
      <div id="rgErr" class="muted" style="color:var(--bad);min-height:18px"></div>
      <button id="rgBtn" style="width:100%">注册并登录</button>
      <div class="muted" style="margin-top:10px;text-align:center"><a href="#" id="toLogin" style="color:var(--brand)">返回登录</a></div>
    </div>
  </div>
</div>

<!-- ================= 管理端 ================= -->
<div id="adminApp" class="hide">
  <div id="topbar">
    <span class="logo">面试智能体</span>
    <div class="tabs">
      <button data-tab="jobs" class="on"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2M3 12h18"/></svg><span>岗位</span></button>
      <button data-tab="orgs"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><circle cx="17" cy="9.5" r="2.6"/><path d="M3.5 20c0-3 2.5-4.6 5.5-4.6s5.5 1.6 5.5 4.6M15.5 15.6c2.6.2 5 1.6 5 4.4"/></svg><span>企业</span></button>
      <button data-tab="data"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4.5"/></svg><span>数据</span></button>
      <button data-tab="account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg><span>账号</span></button>
    </div>
    <span class="grow"></span>
    <span id="whoAmI" class="muted"></span>
    <button class="plain" id="logoutBtn">退出</button>
  </div>
  <div id="main">

    <!-- 岗位工作台（B 端首屏） -->
    <div id="tab-jobs">
      <div class="ws-head">
        <div class="row" style="align-items:flex-end;gap:14px;flex-wrap:wrap">
          <div class="grow">
            <div class="muted" id="wsSpace">个人空间</div>
            <div class="h1" style="margin:2px 0">岗位工作台</div>
            <div class="muted" id="wsCount">共 0 个岗位 · 共 0 位候选人</div>
          </div>
          <div class="stat-cards" style="margin:0;width:auto;min-width:220px">
            <div class="stat-card" style="padding:10px 14px"><b id="wsJobs" style="font-size:20px">0</b><span>可访问岗位</span></div>
            <div class="stat-card" style="padding:10px 14px"><b id="wsCands" style="font-size:20px">0</b><span>位候选人</span></div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="row"><div class="sec-title grow">岗位与面试</div><button id="showCreate">＋ 创建 AI 面试</button></div>
        <div class="row" style="margin-top:10px;gap:8px;flex-wrap:wrap">
          <input id="jobSearch" class="grow" style="min-width:160px;margin:0" placeholder="搜索岗位名称">
          <div class="funnel" style="margin-top:0" id="jobFilterRow">
