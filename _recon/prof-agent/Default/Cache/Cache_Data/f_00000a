/* ===== 通用分页（岗位列表 / 报告列表共用）===== */
var PAGES = { jobs: { cur: 0, max: 1, size: 4 }, reports: { cur: 0, max: 1, size: 15 } };
function pageReset(k) { PAGES[k].cur = 0; }
function pageGo(k, d) { PAGES[k].cur = Math.min(Math.max(PAGES[k].cur + d, 0), PAGES[k].max - 1); if (k === 'jobs') paintJobs(); else paintReports(); }
function pagerHtml(k) {
  var p = PAGES[k];
  if (p.max <= 1) return '';
  return '<div class="pager">' +
    '<button class="plain" onclick="pageGo(\'' + k + '\',-1)"' + (p.cur <= 0 ? ' disabled' : '') + '>上一页</button>' +
    '<span class="pg">第 ' + (p.cur + 1) + ' / ' + p.max + ' 页</span>' +
    '<button class="plain" onclick="pageGo(\'' + k + '\',1)"' + (p.cur >= p.max - 1 ? ' disabled' : '') + '>下一页</button></div>';
}
function paginate(k, list) {
  var p = PAGES[k];
  p.max = Math.max(1, Math.ceil(list.length / p.size));
  if (p.cur >= p.max) p.cur = p.max - 1;
  return list.slice(p.cur * p.size, (p.cur + 1) * p.size);
}
