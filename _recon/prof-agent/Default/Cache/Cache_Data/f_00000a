  if (CAND.questions.length >= CAND.total) return;
  /* 追问式出题：先确认当前题已作答，再让 AI 根据回答生成下一题；二轮同时并行触发该题的 AI 能力评估 */
  if (!String(CAND.answers[CAND.cur] || '').trim()) {
