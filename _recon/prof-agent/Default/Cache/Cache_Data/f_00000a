/* ---------- 报告详情 ---------- */
window.openDetail = function (id) {
  /* 网络偶发失败时自动重试一次，避免报告详情静默空白 */
  function load() { return api('/api/reports/' + id).then(function (r) { window.__curReport = r; paintDetail(r); }); }
  load().catch(function () {
    toast('报告加载失败，正在重试…');
    setTimeout(function () { load().catch(function () { toast('报告加载失败，请检查网络后重试'); }); }, 1500);
  });
};
function verdictCls(v) { return v === '通过' ? 'v-pass' : v === '不通过' ? 'v-fail' : 'v-wait'; }
function stageZh(s) { return { pending: '待决定', interviewing: '二轮进行中', practice: '第三关·实操中', evaluated: '已评估', offer: '已发 Offer', signing: '待签约', signed: '已签约' }[s] || s; }
/** 三维能力雷达图（沟通/学习/执行，0-100），画布留足标签空间避免文字被裁切 */
function radarSvg(sc) {
  var cx = 110, cy = 106, R = 60, ang = [-90, 30, 150];
  function pt(v, a) { var rad = a * Math.PI / 180; return [cx + Math.cos(rad) * R * v / 100, cy + Math.sin(rad) * R * v / 100]; }
  var grid = [25, 50, 75, 100].map(function (v) {
    var p = ang.map(function (a) { var q = pt(v, a); return q[0].toFixed(1) + ',' + q[1].toFixed(1); }).join(' ');
    return '<polygon points="' + p + '" fill="none" stroke="#e8e4f4" stroke-width="0.8"/>';
  }).join('');
  var axes = ang.map(function (a) { var q = pt(100, a); return '<line x1="' + cx + '" y1="' + cy + '" x2="' + q[0].toFixed(1) + '" y2="' + q[1].toFixed(1) + '" stroke="#e8e4f4" stroke-width="0.8"/>'; }).join('');
  var vals = [sc.communication, sc.learning, sc.execution];
  var dp = vals.map(function (v, i) { var q = pt(Math.max(5, v), ang[i]); return q[0].toFixed(1) + ',' + q[1].toFixed(1); }).join(' ');
  var labels = ang.map(function (a, i) {
    var q = pt(82, a);
    return '<text x="' + q[0].toFixed(1) + '" y="' + (q[1] + 4).toFixed(1) + '" text-anchor="middle" font-size="11" fill="#6f6890">' + ['沟通', '学习', '执行'][i] + ' ' + vals[i] + '</text>';
  }).join('');
  return '<svg viewBox="0 0 220 204" style="width:220px;max-width:100%" role="img" aria-label="三维能力雷达图">' + grid + axes +
    '<polygon points="' + dp + '" fill="rgba(109,40,217,.16)" stroke="#6d28d9" stroke-width="1.5"/>' + labels + '</svg>';
}
