function renderJobPrep(prep) {
  var el = $('#jobPrepResult');
  if (!el) return;
  if (!prep) { el.innerHTML = ''; return; }
  var dims = { communication: '沟通表达', learning: '学习能力', execution: '执行落地' };
  function rows(items, title) {
    if (!items || !items.length) return '';
    return '<div class="sec-title" style="margin-top:14px">' + title + '</div>' + items.map(function (item, i) {
      if (typeof item === 'string') return '<div class="qa"><div class="a">' + esc(item) + '</div></div>';
      var dimension = dims[item.dimension] || item.dimension || '';
      return '<div class="qa"><div class="q">' + (i + 1) + '. ' + (dimension ? '<span class="tag">' + esc(dimension) + '</span> ' : '') + esc(item.label || item.question || '') + '</div>' +
        (item.reason ? '<div class="a">考察目的：' + esc(item.reason) + '</div>' : '') +
        (item.followup ? '<div class="a">回答含糊时追问：' + esc(item.followup) + '</div>' : '') +
        (item.material ? '<div class="material">' + esc(item.material) + '</div>' : '') + '</div>';
    }).join('');
  }
  var rubric = (prep.rubric || []).map(function (item) {
    return '<div class="qa"><div class="q">' + esc(item.dimension || '评判维度') + (item.weight != null ? ' · 权重 ' + esc(item.weight) + '%' : '') + '</div>' +
      (item.excellent ? '<div class="a">优秀：' + esc(item.excellent) + '</div>' : '') +
      (item.pass ? '<div class="a">通过：' + esc(item.pass) + '</div>' : '') +
      (item.risk ? '<div class="a">风险信号：' + esc(item.risk) + '</div>' : '') + '</div>';
  }).join('');
  el.innerHTML = '<div class="ai-eval"><span class="tag">模型已生成</span><span>' + esc(prep.provider || '') + ' · ' + esc(prep.model || '') + (prep.generatedAt ? ' · ' + fmtTime(prep.generatedAt) : '') + '</span></div>' +
    (prep.summary ? '<div class="p-step">' + esc(prep.summary) + '</div>' : '') +
    rows(prep.candidateProfile, '候选人画像') + rows(prep.focus, '岗位考察重点') +
    rows(prep.round1, '第一轮 · 简历事实核验') + rows(prep.round2, '第二轮 · 综合能力评估') +
    (rubric ? '<div class="sec-title" style="margin-top:14px">评分标准</div>' + rubric : '') +
    rows(prep.risks, '需要复核的风险') + (prep.nextAction ? '<div class="p-step"><b>建议动作</b><br>' + esc(prep.nextAction) + '</div>' : '');
}

function loadJobPrep(jobId) {
  var status = $('#jobPrepStatus');
  if (!status) return;
  status.textContent = '正在读取 AI 配置与岗位方案…';
  api('/api/jobs/' + encodeURIComponent(jobId) + '/ai-prep')
    .then(function (data) {
      var llm = data.llm || {};
      status.textContent = llm.enabled
        ? 'AI 已接入 · ' + (llm.provider_name || llm.provider) + ' · ' + (llm.model || '')
        : 'AI 尚未接入。请打开「账号」页配置 API，再返回此处生成方案。';
      renderJobPrep(data.prep);
      var btn = $('#generateJobPrep');
      if (btn) btn.onclick = function () {
        var b = this; b.disabled = true; b.textContent = 'AI 正在生成…';
        status.textContent = '正在调用模型分析岗位 JD 并生成两轮面试方案…';
        api('/api/jobs/' + encodeURIComponent(jobId) + '/ai-prep', { method: 'POST', body: {} })
          .then(function (out) { renderJobPrep(out.prep); status.textContent = '岗位 AI 面试方案已生成并保存。'; toast('AI 面试方案已生成'); })
          .catch(function (e) { status.textContent = e.error || 'AI 生成失败'; toast(e.error || 'AI 生成失败'); })
          .then(function () { b.disabled = false; b.textContent = '重新生成岗位 AI 面试方案'; });
      };
    })
    .catch(function (e) { status.textContent = (e && e.error) || '加载岗位 AI 方案失败'; });
}

