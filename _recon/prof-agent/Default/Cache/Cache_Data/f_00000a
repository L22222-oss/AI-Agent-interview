};
function loadReports() {
  api('/api/reports?jobId=' + encodeURIComponent(CURRENT_JOB.id)).then(function (rs) { RLIST = rs; paintReportFilter(); paintReports(); });
}
function paintReportFilter() {
  var c = { all: RLIST.length, pending: 0, interviewing: 0, practice: 0, evaluated: 0, offer: 0, signing: 0, signed: 0 };
  RLIST.forEach(function (r) { if (c[r.stage] !== undefined) c[r.stage]++; });
  var names = { all: '全部', pending: '待决定', interviewing: '二轮进行中', practice: '第三关·实操中', evaluated: '已评估', offer: '已发Offer', signing: '待签约', signed: '已签约' };
  $('#reportFilter').innerHTML = Object.keys(names).map(function (k) {
    return '<span class="seg' + (FILTER === k ? ' on' : '') + '" data-f="' + k + '">' + names[k] + ' ' + c[k] + '</span>';
  }).join('');
  $$('#reportFilter .seg').forEach(function (s) { s.onclick = function () { FILTER = s.dataset.f; pageReset('reports'); paintReportFilter(); paintReports(); }; });
}
var ADV_RANK = { advance: 0, round2: 1, hold: 2, reject: 3, none: 4 };
function stageTag(stage) {
  var m = { pending: ['待决定', ''], interviewing: ['二轮进行中', 'blue'], practice: ['第三关·实操中', 'amber'], evaluated: ['已评估', ''], offer: ['已发Offer', 'amber'], signing: ['待签约', 'amber'], signed: ['已签约', ''] };
  var s = m[stage] || ['—', 'gray'];
  return '<span class="tag ' + s[1] + '">' + s[0] + '</span>';
}
function paintReports() {
  var list = RLIST.filter(function (r) { return FILTER === 'all' || r.stage === FILTER; })
    .sort(function (a, b) { return (ADV_RANK[(a.recommend || {}).action] || 4) - (ADV_RANK[(b.recommend || {}).action] || 4); });
  /* 分页：每页 15 条，筛选变化时已重置回第 1 页 */
  var pageList = paginate('reports', list);
  var html = pageList.map(function (r) {
    var r1 = r.round1 ? '<span class="verdict ' + (r.round1.verdict === '通过' ? 'v-pass' : 'v-fail') + '">一轮' + r.round1.verdict + '</span>' : '';
    var r2 = r.eval ? '<span class="verdict ' + (r.eval.verdict === '通过' ? 'v-pass' : r.eval.verdict === '不通过' ? 'v-fail' : 'v-wait') + '">二轮' + r.eval.verdict + '</span>' : '';
    return '<div class="rep">' +
      (BATCH_MODE ? '<input type="checkbox" data-id="' + r.id + '"' + (BATCH[r.id] ? ' checked' : '') + ' style="width:auto;margin-top:10px">' : '') +
      '<div class="avatar">' + esc((r.cand || '?').charAt(0)) + '</div>' +
      '<div class="grow"><div class="row"><b>' + esc(r.cand) + '</b>' + r1 + r2 + stageTag(r.stage) + '</div>' +
      '<div class="muted">完成于 ' + fmtTime(r.at) + (r.recommend ? ' · AI：' + esc(r.recommend.text) : '') + '</div></div>' +
      '<button class="plain" onclick="openDetail(\'' + r.id + '\')">查看报告</button>' +
      '</div>';
  }).join('');
  html += pagerHtml('reports');
  $('#reportList').innerHTML = html || '<div class="muted" style="padding:20px 0">暂无候选人报告。候选人完成面试后，报告会出现在这里。</div>';
  $$('#reportList input[type=checkbox]').forEach(function (cb) { cb.onchange = function () { BATCH[cb.dataset.id] = cb.checked; $('#batchCount').textContent = '已选 ' + Object.keys(BATCH).filter(function (k) { return BATCH[k]; }).length + ' 人'; }; });
}
$('#batchToggle').onclick = function () { BATCH_MODE = !BATCH_MODE; BATCH = {}; $('#batchBar').classList.toggle('hide', !BATCH_MODE); $('#batchToggle').textContent = BATCH_MODE ? '完成' : '批量'; paintReports(); };
$('#batchAdvance').onclick = function () {
  var ids = Object.keys(BATCH).filter(function (k) { return BATCH[k]; });
  if (!ids.length) { toast('请先勾选报告'); return; }
