  } else if (d.stage === 'offer' || d.stage === 'signing' || d.stage === 'signed') {
    h += '<div class="p-step"><b>恭喜，已进入录用流程</b>如收到 Offer 链接，请打开链接确认并完成签约。</div>';
  } else if (d.r2Done && d.r2Verdict === '不通过') {
    h += '<div class="p-step"><b>本轮面试已结束</b>感谢参与，期待与你的下次相遇。</div>';
  } else {
    h += '<div class="p-step"><b>进行中</b>当前环节：' + esc(stageZh(d.stage)) + '。请按 HR 的指引继续，或稍后再来查询。</div>';
  }
  h += '<div class="muted" style="margin-top:10px;text-align:center">只显示你本人的结果 · 有疑问请联系 HR</div>';
  $('#portalBody').innerHTML = h;
  if (d.canRound2) $('#ptR2').onclick = function () {
    location.href = '/?job=' + encodeURIComponent(jobId) + '&name=' + encodeURIComponent(jobName) + '&cand=' + encodeURIComponent(d.cand) + '&round=2&rid=' + encodeURIComponent(d.id);
  };
  if (d.canPractice) {
    $('#ptSubmit').onclick = function () {
      var url = $('#ptUrl').value.trim(), note = $('#ptNote').value.trim();
      var err = $('#ptErr2'); err.textContent = '';
      if (!/^https?:\/\/.+\..+/.test(url)) { err.textContent = '请填写公网可访问的作品网址（http/https 开头）'; return; }
      var btn = this; btn.disabled = true; btn.textContent = '提交中…';
      api('/api/reports/' + encodeURIComponent(d.id) + '/practice', { method: 'POST', body: { url: url, note: note } })
        .then(function (out) {
          if (out.autoConfirmed) {
            $('#portalBody').innerHTML = '<div class="p-step"><b>提交成功，已通过第三关</b>系统预评 <b style="color:var(--brand)">' + out.autoScore + ' 分</b>（网址已验证可达），系统已自动确认，你的面试全部环节已完成，HR 将尽快与你联系后续安排。</div>';
          } else {
            $('#portalBody').innerHTML = '<div class="p-step"><b>提交成功</b>系统预评 <b style="color:var(--brand)">' + out.autoScore + ' 分</b>' + (out.reachable ? '（网址已验证可达）' : '（网址暂未访问成功，HR 会人工核验）') + '。HR 确认后进入下一环节，请耐心等待。</div>';
          }
        })
        .catch(function (e) { btn.disabled = false; btn.textContent = '提交实操作品'; err.textContent = (e && e.error) || '提交失败'; });
    };
  }
}

/** 电子签约：条款确认 + 手写签名画板（Pointer 事件，兼容触屏） */
function renderSignUI(rid, cand, contract) {
  var box = $('#contractBox');
  box.innerHTML = '<div class="h2" style="margin-top:14px">电子签约</div>' +
    '<div class="muted">确认以下条款与你的录用信息一致，并在下方手写签名。签署后 HR 立即收到通知。</div>' +
    '<table class="tb" style="margin-top:8px"><tbody>' +
    '<tr><th>职位</th><td>' + esc((contract && contract.title) || '') + '</td></tr>' +
    '<tr><th>薪资</th><td>' + esc((contract && contract.salary) || '') + '</td></tr>' +
    '<tr><th>入职日期</th><td>' + esc((contract && contract.startDate) || '') + '</td></tr>' +
    '</tbody></table>' +
    '<label class="lb">签署姓名（须与本人一致）</label><input id="signName" placeholder="请输入你的姓名">' +
    '<label class="lb">手写签名（用手指或鼠标在框内签名）</label>' +
    '<canvas id="signPad" width="640" height="220"></canvas>' +
    '<div class="row" style="margin-top:10px"><button class="plain grow" id="signClear">清除重写</button><span class="grow"></span><button class="grow" id="signConfirm">确认签署</button></div>' +
    '<div id="signErr" class="muted" style="color:var(--bad);min-height:18px;margin-top:6px"></div>';
  var cv = $('#signPad'), ctx = cv.getContext('2d');
  ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, cv.width, cv.height);
  ctx.lineWidth = 3; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#26203a';
  var drawing = false, hasDrawn = false, last = null;
  function pos(e) {
    var r = cv.getBoundingClientRect();
    return { x: (e.clientX - r.left) * cv.width / r.width, y: (e.clientY - r.top) * cv.height / r.height };
  }
  cv.addEventListener('pointerdown', function (e) { drawing = true; hasDrawn = true; last = pos(e); e.preventDefault(); });
  cv.addEventListener('pointermove', function (e) {
    if (!drawing) return;
    var p = pos(e);
    ctx.beginPath(); ctx.moveTo(last.x, last.y); ctx.lineTo(p.x, p.y); ctx.stroke();
    last = p; e.preventDefault();
  });
  ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (ev) { cv.addEventListener(ev, function () { drawing = false; }); });
  $('#signClear').onclick = function () { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, cv.width, cv.height); ctx.strokeStyle = '#26203a'; hasDrawn = false; };
  $('#signConfirm').onclick = function () {
    var err = $('#signErr'); err.textContent = '';
    var name = $('#signName').value.trim();
    if (name.length < 2 || name.length > 30) { err.textContent = '请填写 2-30 字的签署姓名（须与本人一致）。'; return; }
    if (!hasDrawn) { err.textContent = '请先在签名框内手写签名。'; return; }
    var btn = this; btn.disabled = true;
    // 导出白底 PNG 签名图
    var out = document.createElement('canvas'); out.width = cv.width; out.height = cv.height;
    out.getContext('2d').drawImage(cv, 0, 0);
    api('/api/reports/' + encodeURIComponent(rid) + '/contract/sign', { method: 'POST', body: { name: name, signData: out.toDataURL('image/png') } })
      .then(function () {
        box.innerHTML = '<div class="card" style="margin-top:12px;background:var(--brand-soft)"><div class="h2">签署完成</div>' +
          '<div class="muted">电子合同已生效，HR 已同步收到。请按约定日期（' + esc((contract && contract.startDate) || '—') + '）报到，入职当天请携带有效证件。</div></div>';
        $('#offState').innerHTML = '';
        toast('签署成功');
      })
      .catch(function (d2) { btn.disabled = false; err.textContent = (d2 && d2.error) || '签署失败，请重试'; });
  };
}

/* ================= 简历文字提取（浏览器内，原文件不上传） ================= */
function extractText(file) {
  var name = (file.name || '').toLowerCase();
  if (/\.(txt|md|csv)$/.test(name)) return file.text().then(function (t) { if (!t.trim()) throw new Error('文件内容为空'); return t; });
  if (/\.docx$/.test(name)) return extractDocx(file);
  if (/\.pdf$/.test(name)) return extractPdf(file);
  return Promise.reject(new Error('暂不支持该格式，请转存为 PDF/DOCX/TXT 或直接粘贴'));
}
/** DOCX：解析 ZIP 目录 → DecompressionStream 原生解压 word/document.xml → 抽取文本 */
function extractDocx(file) {
  return file.arrayBuffer().then(function (buf) {
    var dv = new DataView(buf);
    // 定位 EOCD
    var eocd = -1;
    for (var i = buf.byteLength - 22; i >= Math.max(0, buf.byteLength - 66000); i--) {
      if (dv.getUint32(i, true) === 0x06054b50) { eocd = i; break; }
    }
    if (eocd < 0) throw new Error('不是有效的 DOCX 文件');
    var count = dv.getUint16(eocd + 10, true), ptr = dv.getUint32(eocd + 16, true);
    var u8 = new Uint8Array(buf), target = null;
    for (var n = 0; n < count; n++) {
      if (dv.getUint32(ptr, true) !== 0x02014b50) break;
      var method = dv.getUint16(ptr + 10, true);
      var csize = dv.getUint32(ptr + 20, true);
      var nameLen = dv.getUint16(ptr + 28, true), extraLen = dv.getUint16(ptr + 30, true), cmtLen = dv.getUint16(ptr + 32, true);
      var lho = dv.getUint32(ptr + 42, true);
      var fname = new TextDecoder().decode(u8.slice(ptr + 46, ptr + 46 + nameLen));
      if (fname === 'word/document.xml') {
        // 读本地文件头定位数据起点
        var lnLen = dv.getUint16(lho + 26, true), exLen = dv.getUint16(lho + 28, true);
        target = { method: method, data: u8.slice(lho + 30 + lnLen + exLen, lho + 30 + lnLen + exLen + csize) };
        break;
      }
      ptr += 46 + nameLen + extraLen + cmtLen;
    }
    if (!target) throw new Error('DOCX 中未找到正文');
    var p;
    if (target.method === 0) { p = Promise.resolve(target.data); }
    else if (target.method === 8 && typeof DecompressionStream !== 'undefined') {
      p = new Response(new Blob([target.data]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).arrayBuffer();
    } else throw new Error('浏览器不支持解压，请直接粘贴正文');
    return p.then(function (xmlBuf) {
      var xml = new TextDecoder().decode(xmlBuf);
      return xmlToText(xml);
    });
  });
}
function xmlToText(xml) {
  var t = xml.replace(/<w:p[ >]/g, '\n<w:p ').replace(/<w:tab[^>]*\/>/g, '\t').replace(/<w:br[^>]*\/>/g, '\n');
  t = t.replace(/<[^>]+>/g, '');
  var map = { '&lt;': '<', '&gt;': '>', '&amp;': '&', '&quot;': '"', '&apos;': "'" };
  return t.replace(/&lt;|&gt;|&amp;|&quot;|&apos;/g, function (m) { return map[m]; }).replace(/\n{3,}/g, '\n\n').trim();
}
/** PDF：按需加载 pdf.js（公共 CDN），失败则提示粘贴正文 */
function loadPdfJs() {
  if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
  if (window.__pdfReady) return window.__pdfReady;
  var urls = [
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js',
    'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js',
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js',
  ];
  window.__pdfReady = new Promise(function (resolve) {
    var i = 0;
    (function next() {
      if (i >= urls.length) return resolve(null);
      var s = document.createElement('script');
      s.src = urls[i++];
      s.onload = function () { resolve(window.pdfjsLib || null); };
      s.onerror = next;
      document.head.appendChild(s);
    })();
  });
  return window.__pdfReady;
}
function extractPdf(file) {
  return loadPdfJs().then(function (lib) {
    if (!lib) throw new Error('PDF 组件加载失败（需联网），请直接粘贴正文');
    return file.arrayBuffer().then(function (buf) {
      return lib.getDocument({ data: buf }).promise.then(function (pdf) {
        if (pdf.numPages > 20) throw new Error('PDF 超过 20 页');
        var pages = [];
        for (var i = 1; i <= pdf.numPages; i++) pages.push(pdf.getPage(i).then(function (pg) { return pg.getTextContent().then(function (tc) { return tc.items.map(function (it) { return it.str; }).join(' '); }); }));
        return Promise.all(pages).then(function (arr) {
          var t = arr.join('\n').replace(/[ \t]{2,}/g, ' ').trim();
          if (!t) throw new Error('未提取到文字（可能是扫描件），请直接粘贴');
          return t;
        });
      });
    });
  });
}

