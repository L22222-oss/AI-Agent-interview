      } else if (r.stage === 'practice') {
        html += '<form id="practiceForm"><div class="row"><div class="grow"><label class="lb">确认得分（0-100）</label><input id="prScore" type="number" min="0" max="100" value="' + r.practice.autoScore + '"></div>' +
          '<div class="grow"><label class="lb">评语（可选）</label><input id="prComment" placeholder="如：功能完整，部署可用"></div></div>' +
          '<div class="row" style="margin-top:10px"><button class="grow">确认得分 · 进入已评估</button>' +
          '<button type="button" class="ghost grow" onclick="adoptPracticePre(\'' + r.id + '\')">一键采纳系统预评</button></div></form>';
      }
    } else {
      html += '<div class="muted">等待候选人提交实操作品（候选人凭姓名 + 认证码在自助入口提交）。</div>';
    }
  }
  // 第二轮链接
  if (r1 && r1.verdict === '通过' && !r2) {
    var link2 = location.origin + '/?job=' + encodeURIComponent(r.jobId) + '&name=' + encodeURIComponent(r.jobName) + '&cand=' + encodeURIComponent(r.cand) + '&round=2&rid=' + encodeURIComponent(r.id);
    html += '<label class="lb">第二轮面试链接（发给候选人）</label><div class="linkbox">' + esc(link2) + '</div>' +
      '<button class="ghost" style="margin-top:8px" onclick="copyText(this.dataset.l, \'已复制\')" data-l="' + esc(link2) + '">复制第二轮链接</button>';
  }
  // Offer 与电子签约
  html += '<div class="h2" style="margin-top:16px">Offer 与签约</div>';
  if (r.contract) {
    html += '<div class="muted">电子合同：' + (r.contract.status === 'signed'
      ? '已签署（' + esc(r.contract.name || '') + ' · ' + fmtTime(r.contract.signedAt) + '）'
