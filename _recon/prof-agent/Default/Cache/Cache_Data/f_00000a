    var cl = location.origin + '/?offer=' + encodeURIComponent(r.id);
    html += '<label class="lb">Offer / 签约链接（同一链接：确认 Offer 后直接进入签约）</label><div class="linkbox">' + esc(cl) + '</div>' +
      '<div class="row" style="margin-top:8px"><button class="ghost" onclick="copyText(this.dataset.l,\'链接已复制\')" data-l="' + esc(cl) + '">复制链接</button>' +
      (r.contract.status === 'signed' ? '<button onclick="downloadContractDoc(\'' + r.id + '\')">下载合同确认单</button>' : '') + '</div>';
  } else if (r.offer) {
    html += '<div class="muted">状态：' + esc(offerStatusText(r.offer.status)) + ' · 薪资 ' + esc(r.offer.salary || '—') + ' · 入职 ' + esc(r.offer.startDate || '—') + '</div>';
