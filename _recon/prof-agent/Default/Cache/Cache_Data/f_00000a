/* ================= API ================= */
/* silent401：启动会话探测等场景，401 属预期，不弹「登录已过期」 */
function api(path, opts, silent401) {
  opts = opts || {};
  function once() {
    var o = { method: opts.method || 'GET', credentials: 'same-origin', headers: {} };
    if (opts.body !== undefined) { o.headers['Content-Type'] = 'application/json'; o.body = JSON.stringify(opts.body); }
    return fetch(path, o).then(function (r) {
      if (r.status === 401 && path !== '/api/auth/login') {
        if (!silent401) { toast('登录已过期，请重新登录'); showLogin(); }
        throw { status: 401, error: '登录已过期，请重新登录' };
      }
      // 响应不是合法 JSON（被运营商网关截断等）：给出可理解的提示
      return r.json().catch(function () { throw { error: '响应中断，请重试' }; }).then(function (d) { if (!r.ok) throw d; return d; });
    }, function () { throw { network: true }; });
  }
  return once().catch(function (e) {
    // 网络层失败（断网/连接被重置）：自动重试一次，仍失败再给出明确文案
    if (e && e.network) {
      return new Promise(function (res) { setTimeout(res, 900); }).then(once).catch(function (e2) {
        throw (e2 && e2.network) ? { error: '网络连接不稳定，请稍后重试；若反复出现请刷新页面，确认操作是否已生效' } : e2;
      });
    }
    throw e;
  });
}

