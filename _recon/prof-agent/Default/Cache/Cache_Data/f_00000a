/** 从模型输出中提取 JSON 对象（剥离 markdown 围栏等噪音） */
function parseJSONText(txt) {
  let s = String(txt).trim().replace(/^```(?:json)?/i, '').replace(/```\s*$/, '').trim();
  const a = s.indexOf('{'), b = s.lastIndexOf('}');
  if (a < 0 || b <= a) throw new Error('bad-json');
  return JSON.parse(s.slice(a, b + 1));
}
/** 服务端 LLM 代理（DeepSeek，密钥存服务端不落前端） */
function proxyJSON(systemPrompt, userPrompt) {
  return fetch('/api/llm', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: [{ role: 'system', content: systemPrompt }, { role: 'user', content: userPrompt }] }) })
    .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw new Error((d && d.error) || 'llm-fail'); return d.content; }); })
    .then(parseJSONText);
}
/** 流式收集完整回复并解析 JSON（模型只输出一个 JSON 对象）；优先服务端代理，失败回退云服务直连 */
async function llmJSON(systemPrompt, userPrompt) {
  try { return await withTimeout(proxyJSON(systemPrompt, userPrompt), 45000); } catch (e) { if (!CLOUD) throw e; }
  const modelId = await llmModelId();
  if (!modelId) throw new Error('no-model');
  let out = '';
  for await (const chunk of CLOUD.llm.chat.completions.create({
    model: modelId,
    messages: [{ role: 'system', content: systemPrompt }, { role: 'user', content: userPrompt }],
    stream: true,
    response_format: { type: 'json_object' },
    temperature: 0.4,
  })) {
    const d = chunk && chunk.choices && chunk.choices[0] && chunk.choices[0].delta;
    if (d && d.content) out += d.content;
  }
  return parseJSONText(out);
}
