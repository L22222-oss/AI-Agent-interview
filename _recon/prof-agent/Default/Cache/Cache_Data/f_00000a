  if (CAND.isRound2 && CAND.mode === 'llm' && !CAND.evalPromises[CAND.cur] && CAND.evals[CAND.cur] === undefined) {
    // 评估与出题并行，不增加等待；评估结果在提交前统一回收
    var eidx = CAND.cur;
    CAND.evals[eidx] = undefined;
    CAND.evalPromises[eidx] = aiEvalAnswer(eidx).then(function (ev) { CAND.evals[eidx] = ev; return ev; }).catch(function () { CAND.evals[eidx] = null; return null; });
  }
  CAND.generating = true; paintStep();
  var idx = CAND.questions.length;
  aiNextQuestion(idx).then(function (q) {
    CAND.questions.push(q.text);
